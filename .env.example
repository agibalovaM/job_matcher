# Copy to .env and fill secrets locally. Do not commit .env.

APP_DB_PATH=data/job_matcher.sqlite
APP_POLL_INTERVAL_SECONDS=300
APP_THRESHOLD=4

# Only for the official hh.ru API (hh-once/serve), not for the browser source. Use your contact email.
HH_USER_AGENT=MarinaJobMatcher/0.1 (your-email@example.com)
# Optional. Leave empty unless hh.ru requires OAuth/captcha resolution.
HH_ACCESS_TOKEN=

# Telegram Bot API credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LinkedIn Job Alerts from email (IMAP, read-only). See README: "LinkedIn Job Alerts".
# Password is an app password, never your main mailbox or LinkedIn password:
#   Mail.ru: "Пароль для внешнего приложения", host imap.mail.ru
#   Gmail:   Google App Password (16 chars), host imap.gmail.com (default when empty)
# Example below is for Mail.ru.
LINKEDIN_IMAP_HOST=imap.mail.ru
LINKEDIN_IMAP_USER=
LINKEDIN_IMAP_PASSWORD=
LINKEDIN_IMAP_MAILBOX=INBOX
# Comma-separated list if LinkedIn adds/changes sender addresses.
LINKEDIN_SENDER=jobalerts-noreply@linkedin.com
# Only look at emails from the last N days.
LINKEDIN_SINCE_DAYS=14
# true = mark processed emails as read. Default false: mailbox is not modified.
LINKEDIN_MARK_AS_READ=false
# Optional: local .mbox export instead of / in addition to IMAP.
LINKEDIN_MBOX_PATH=

